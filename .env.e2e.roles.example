# Copy this file to .env.e2e.roles.local. The local file is ignored by Git.
# Use distinct staging-only accounts. Never place production credentials here.
E2E_RECEPTIONIST_USER=staging_receptionist_username
E2E_RECEPTIONIST_PASSWORD=staging_receptionist_password
E2E_MANAGER_USER=staging_manager_username
E2E_MANAGER_PASSWORD=staging_manager_password

# Required acknowledgement for the staging-only mutation matrix.
E2E_CONFIRM_STAGING_MUTATIONS=release-a-staging-only
E2E_HEADLESS=true

# Optional. Defaults to Playstation.
E2E_V2_ROLE_HOP_STATION=Playstation
