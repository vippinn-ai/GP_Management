# Copy this file to .env.e2e.local. The local file is ignored by Git.
# Use staging-only accounts. Never place production credentials here.
E2E_BASE_URL=https://gp-management-staging-pages.breakperfectgaminglounge.workers.dev/
E2E_CONFIRM_STAGING_MUTATIONS=release-a-staging-only
E2E_USER_A=staging_admin_username
E2E_PASSWORD_A=staging_admin_password
E2E_USER_B=staging_observer_username
E2E_PASSWORD_B=staging_observer_password

# Optional stable choices. Defaults match the current staging catalog.
E2E_PAUSE_STATION=8 Ball Pool
E2E_HOP_STATION=Playstation
E2E_HEADLESS=true
